<!-- app/views/home/index.html.erb -->
  <!-- Main -->
  <main class="w-full max-w-md px-4 mt-4 flex-grow">

    <!-- 新しい能力を生成する -->
    <button class="w-full bg-purple-400 hover:bg-purple-500 text-white font-semibold py-3 rounded-full mb-4 shadow">
      新しい能力を生成する
    </button>

    <!-- あなたの能力一覧 -->
    <section class="mb-4">
      <h2 class="text-lg font-bold text-center mb-2">あなたの能力一覧</h2>
      <div class="bg-white border rounded-md p-4 text-center">
        <p class="text-gray-700 mb-2">ログインしてください</p>
        <button class="w-full border border-gray-300 rounded-md py-2">ログイン</button>
      </div>
    </section>

    <!-- 仲間の能力一覧 -->
    <section class="mb-4">
      <h2 class="text-lg font-bold text-center mb-2">仲間の能力一覧</h2>
      <div class="bg-white border rounded-md p-4 text-center">
        <p class="text-gray-700 mb-2">ログインしてください</p>
        <button class="w-full border border-gray-300 rounded-md py-2">ログイン</button>
      </div>
    </section>

    <!-- 能力図鑑ボタン -->
    <button class="w-full bg-purple-400 hover:bg-purple-500 text-white font-semibold py-3 rounded-full mb-4 shadow">
      能力図鑑を見る
    </button>

    <!-- 最近確認された能力一覧 -->
    <section>
      <h3 class="text-base font-semibold mb-2 text-center">最近確認された能力一覧</h3>
      <div class="space-y-3">
        <% @recent_abilities.each do |ability| %>
          <div class="flex justify-between items-center bg-gray-100 p-3 rounded-md">
            <div>
              <div class="font-semibold"><%= ability[:name] %></div>
              <div class="text-sm text-gray-600"><%= ability[:title] %></div>
            </div>
            <span class="inline-block px-3 py-1 text-sm rounded-full bg-white border font-medium">
              <%= ability[:type] %>
            </span>
          </div>
        <% end %>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="w-full max-w-md text-center text-xs text-gray-500 mt-6 pb-4">
    <div>@2025 Aura Translator</div>
    <div class="mt-2 space-x-3">
      <a href="#" class="underline">利用規約</a>
      <a href="#" class="underline">プライバシーポリシー</a>
      <a href="#" class="underline">お問い合わせ</a>
    </div>
  </footer>
</div>
