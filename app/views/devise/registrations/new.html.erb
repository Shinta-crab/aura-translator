<main class="w-full max-w-md px-4 mt-4 flex-grow">
  <section class="mb-4">
      <h2 class="text-lg font-bold text-center mb-2">ユーザー登録</h2>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field mb-4">
        <%= f.label "アカウント名" %><br />
        <%= f.email_field :username, autofocus: true, autocomplete: "username", class: 'w-full bg-gray-200 rounded-md py-2' %>
      </div>

      <div class="field mb-4">
        <%= f.label "メールアドレス" %><br />
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'w-full bg-gray-200 rounded-md py-2' %>
      </div>

      <div class="field mb-4">
        <%= f.label "パスワード" %>
        <% if @minimum_password_length %>
        <em>(<%= @minimum_password_length %>文字以上)</em>
        <% end %><br />
        <%= f.password_field :password, autocomplete: "new-password", class: 'w-full bg-gray-200 rounded-md py-2' %>
      </div>

      <div class="field mb-4">
        <%= f.label "パスワード確認" %><br />
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: 'w-full bg-gray-200 rounded-md py-2' %>
      </div>

      <div class="actions mb-4">
        <%= f.submit "新規登録する", class: 'w-full bg-purple-400 hover:bg-purple-500 text-white font-semibold py-3 rounded-full mb-4 shadow' %>
      </div>
    <% end %> 

    <%= render "devise/shared/links" %>
  </section>
</main>
