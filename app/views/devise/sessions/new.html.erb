<main class="w-full max-w-md px-4 mt-4 flex-grow">
  <section class="mb-4">
      <h2 class="text-lg font-bold text-center mb-2">ログイン</h2>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field mb-4">
        <%= f.label "アカウント名" %><br />
        <%= f.email_field :username, autofocus: true, autocomplete: "username", class: 'w-full bg-gray-200 rounded-md py-2' %>
      </div>

      <div class="field mb-4">
        <%= f.label "パスワード" %>
        <%= f.password_field :password, autocomplete: "current-password", class: 'w-full bg-gray-200 rounded-md py-2'%>　　
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field mb-4">
          <%= f.check_box :remember_me %>
          <%= f.label "アカウント名、パスワードを記憶する" %>
        </div>
      <% end %>

      <div class="actions mb-4">
        <%= f.submit "ログイン", class: 'w-full bg-purple-400 hover:bg-purple-500 text-white font-semibold py-3 rounded-full mb-4 shadow' %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
</section>
</main
